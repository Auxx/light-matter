{
  "name": "@light-matter/source",
  "author": "hexmode.org",
  "version": "0.0.5",
  "description": "A simple image viewer with HDR photo support for Windows",
  "license": "MIT",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "typia": "typia generate --input libs/internal-api/src/typia --output libs/internal-api/src/models --project libs/internal-api/tsconfig.lib.json",
    "prepare": "husky",
    "lint": "nx run-many --all --target=lint --no-tui",
    "test": "nx run-many --all --target=test --codeCoverage",
    "test:ci": "nx run-many --all --target=test --configuration=ci --parallel=3 --runInBand --ci --code-coverage --coverageReporters=lcov",
    "build:ci": "nx run-many --all --target=build",
    "make:prod": "nx run web:build:production && nx run desktop:build:production && nx run desktop:make",
    "make:prod-appx": "nx run web:build:production && nx run desktop:build:production && nx run desktop:make --makerOptionsPath=apps/desktop/src/app/options/maker-appx.options.json",
    "start:with-args": "cd dist/executables/win-unpacked && \"Light Matter.exe\" \"C:\\Users\\Aleks\\Desktop\\hdr photos\\IMGP8056.jpg\"",
    "postinstall": "electron-builder install-app-deps",
    "nxe:build:frontend": "nx build web",
    "nxe:build:backend": "nx build desktop",
    "nxe:serve:frontend": "nx serve web",
    "nxe:serve:backend": "nx serve desktop",
    "nxe:test:frontend": "nx test web",
    "nxe:test:backend": "nx test desktop",
    "nxe:package:app": "nx run desktop:make --prepackageOnly",
    "nxe:make:app": "nx run desktop:make"
  },
  "private": true,
  "dependencies": {
    "tslib": "2.8.1",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.2",
    "@angular-devkit/schematics": "21.2.2",
    "@angular/build": "21.2.2",
    "@angular/cdk": "21.2.2",
    "@angular/cli": "21.2.2",
    "@angular/common": "21.2.4",
    "@angular/compiler": "21.2.4",
    "@angular/compiler-cli": "21.2.4",
    "@angular/core": "21.2.4",
    "@angular/forms": "21.2.4",
    "@angular/language-service": "21.2.4",
    "@angular/material": "21.2.2",
    "@angular/platform-browser": "21.2.4",
    "@angular/platform-browser-dynamic": "21.2.4",
    "@angular/router": "21.2.4",
    "@eslint/js": "10.0.1",
    "@nx/angular": "22.5.4",
    "@nx/devkit": "^22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/jest": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/web": "22.5.4",
    "@nx/workspace": "22.5.4",
    "@schematics/angular": "21.2.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.18",
    "@swc/helpers": "0.5.19",
    "@types/jest": "30.0.0",
    "@types/node": "24.11.1",
    "@typescript-eslint/utils": "8.57.0",
    "angular-eslint": "21.3.0",
    "dprint": "0.52.0",
    "electron": "41.0.2",
    "eslint": "10.0.3",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-environment-node": "30.3.0",
    "jest-preset-angular": "16.1.1",
    "jest-util": "30.3.0",
    "jsonc-eslint-parser": "3.1.0",
    "lucide-angular": "0.577.0",
    "ng-mocks": "14.15.1",
    "nx": "22.5.4",
    "nx-electron": "22.0.0",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.6",
    "ts-morph": "^28.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "typia": "12.0.2",
    "zone.js": "0.16.1"
  },
  "overrides": {
    "ng-mocks": {
      "@angular/common": "21.2.4",
      "@angular/core": "21.2.4",
      "@angular/forms": "21.2.4",
      "@angular/platform-browser": "21.2.4",
      "rxjs": "7.8.2"
    }
  },
  "volta": {
    "node": "24.14.0",
    "npm": "11.10.1"
  }
}
